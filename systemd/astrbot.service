[Unit]
Description=AstrBot (DSH bridge plugin)
After=network-online.target dsh-qqbridge.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/astrbot
EnvironmentFile=/srv/astrbot.env
ExecStart=/srv/astrbot/venv/bin/astrbot run -p 6185
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
